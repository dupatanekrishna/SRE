global:
  resolve_timeout: 1m

route:
  receiver: "slack-alerts"
  group_wait: 5s
  group_interval: 10s
  repeat_interval: 1h

receivers:
  - name: "slack-alerts"
    slack_configs:
      - api_url: "PASTE_YOUR_SLACK_WEBHOOK_HERE"
        channel: "#YOUR-CHANNEL"
        send_resolved: true
        title: "FinApp SRE Alert"
        text: >-
          Alert: {{ .CommonLabels.alertname }}
          Severity: {{ .CommonLabels.severity }}
          Status: {{ .Status }}
          Summary: {{ .CommonAnnotations.summary }}
          Description: {{ .CommonAnnotations.description }}
